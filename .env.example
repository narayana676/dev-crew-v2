# LLM provider selection: "mock" (default, offline/deterministic), "gemini", or "openai"
LLM_PROVIDER=gemini

# Required if LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Retry / budget / timeout ceilings for the Debugger->Coder loop
DEFAULT_MAX_RETRIES=3
DEFAULT_MAX_BUDGET_USD=2.0
DEFAULT_MAX_EXECUTION_SECONDS=300.0

# Postgres checkpointing (optional; app runs without it for a single /crew/invoke call)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devcrew

# Docker sandbox for real pytest execution of generated code
SANDBOX_DOCKER_IMAGE=python:3.11-slim
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_QUOTA=50000
SANDBOX_TIMEOUT_SECONDS=30.0
